diff --git a/app/src/main/java/helium314/keyboard/latin/PhonectlBridge.kt b/app/src/main/java/helium314/keyboard/latin/PhonectlBridge.kt
new file mode 100644
index 0000000..aebc2c0
--- /dev/null
+++ b/app/src/main/java/helium314/keyboard/latin/PhonectlBridge.kt
@@ -0,0 +1,125 @@
+// SPDX-License-Identifier: GPL-3.0-only
+// phonectl Keyboard: the only addition to HeliBoard. See phonectl/keyboard/README.md.
+
+package helium314.keyboard.latin
+
+import android.content.BroadcastReceiver
+import android.content.ClipboardManager
+import android.content.ComponentName
+import android.content.Context
+import android.content.Intent
+import android.content.IntentFilter
+import android.view.KeyEvent
+import androidx.core.content.ContextCompat
+import helium314.keyboard.latin.utils.Log
+
+/**
+ * Links this keyboard to the phonectl app (same signing key).
+ *
+ * Clipboard: as the default input method this keyboard may read the clipboard
+ * from the background (Android 10+ allows only the focused app and the default
+ * IME). Every new text clip is handed to phonectl, which sends it to the
+ * laptop. Clips marked sensitive (passwords, OTPs) and clips phonectl itself
+ * wrote (marked as coming from a remote device) are never forwarded.
+ *
+ * Typing: phonectl can ask the keyboard to type text or press a key in the
+ * focused field, so the laptop keyboard can type on the phone.
+ *
+ * Both directions use explicit broadcasts guarded by a signature permission.
+ */
+object PhonectlBridge {
+    private const val TAG = "PhonectlBridge"
+    private const val PHONECTL = "com.daanh.phonectl"
+    private const val PERMISSION = "com.daanh.phonectl.permission.BRIDGE"
+    private const val ACTION_CLIP = "com.daanh.phonectl.action.CLIP"
+    private const val ACTION_TYPE = "com.daanh.phonectl.action.TYPE"
+    private const val ACTION_CRASH = "com.daanh.phonectl.action.CRASH"
+    private const val EXTRA_IS_SENSITIVE = "android.content.extra.IS_SENSITIVE"
+    private const val EXTRA_IS_REMOTE_DEVICE = "android.content.extra.IS_REMOTE_DEVICE"
+    /** Binder transactions cap out near 1 MB; UTF-16 doubles the size. */
+    private const val MAX_CHARS = 200_000
+
+    private var receiver: BroadcastReceiver? = null
+
+    fun onCreate(ime: LatinIME) {
+        val r = object : BroadcastReceiver() {
+            override fun onReceive(context: Context, intent: Intent) {
+                if (intent.action != ACTION_TYPE) return
+                try {
+                    type(ime, intent.getStringExtra("text"), intent.getStringExtra("key"))
+                } catch (e: Exception) {
+                    Log.w(TAG, "type failed", e)
+                }
+            }
+        }
+        ContextCompat.registerReceiver(ime, r, IntentFilter(ACTION_TYPE), PERMISSION, null, ContextCompat.RECEIVER_EXPORTED)
+        receiver = r
+    }
+
+    fun onDestroy(ime: LatinIME) {
+        receiver?.let { try { ime.unregisterReceiver(it) } catch (_: Exception) {} }
+        receiver = null
+    }
+
+    /** Called for every primary clip change, whether or not clipboard history is on. */
+    fun onClipChanged(context: Context, clipboard: ClipboardManager) {
+        val text = try {
+            val clip = clipboard.primaryClip ?: return
+            if (clip.itemCount == 0) return
+            val extras = clip.description?.extras
+            if (extras?.getBoolean(EXTRA_IS_SENSITIVE) == true) return
+            if (extras?.getBoolean(EXTRA_IS_REMOTE_DEVICE) == true) return
+            clip.getItemAt(0)?.coerceToText(context)?.toString() ?: return
+        } catch (e: Exception) {
+            Log.w(TAG, "cannot read clip", e)
+            return
+        }
+        if (text.isEmpty() || text.length > MAX_CHARS) return
+        val intent = Intent(ACTION_CLIP)
+            .setComponent(ComponentName(PHONECTL, "$PHONECTL.KeyboardBridge"))
+            .putExtra("text", text)
+            .addFlags(Intent.FLAG_RECEIVER_FOREGROUND)
+        try {
+            context.sendBroadcast(intent, PERMISSION)
+        } catch (e: Exception) {
+            Log.w(TAG, "cannot hand clip to phonectl", e)
+        }
+    }
+
+    /**
+     * Hands a crash report (versions and stack trace only, no typed text) to
+     * phonectl, which sends it to the laptop. Called from the crash handler.
+     */
+    @JvmStatic
+    fun sendCrash(context: Context, report: String) {
+        try {
+            context.sendBroadcast(Intent(ACTION_CRASH)
+                .setComponent(ComponentName(PHONECTL, "$PHONECTL.KeyboardBridge"))
+                .putExtra("report", report.take(32_000))
+                .addFlags(Intent.FLAG_RECEIVER_FOREGROUND), PERMISSION)
+        } catch (_: Throwable) {
+        }
+    }
+
+    private fun type(ime: LatinIME, text: String?, key: String?) {
+        val ic = ime.currentInputConnection ?: return
+        if (!text.isNullOrEmpty()) {
+            ic.finishComposingText()
+            ic.commitText(text, 1)
+        }
+        when (key) {
+            null, "" -> {}
+            "enter" -> if (!ime.sendDefaultEditorAction(true)) ime.sendDownUpKeyEvents(KeyEvent.KEYCODE_ENTER)
+            "newline" -> ime.sendDownUpKeyEvents(KeyEvent.KEYCODE_ENTER)
+            "backspace" -> ime.sendDownUpKeyEvents(KeyEvent.KEYCODE_DEL)
+            "delete" -> ime.sendDownUpKeyEvents(KeyEvent.KEYCODE_FORWARD_DEL)
+            "tab" -> ime.sendDownUpKeyEvents(KeyEvent.KEYCODE_TAB)
+            "left" -> ime.sendDownUpKeyEvents(KeyEvent.KEYCODE_DPAD_LEFT)
+            "right" -> ime.sendDownUpKeyEvents(KeyEvent.KEYCODE_DPAD_RIGHT)
+            "up" -> ime.sendDownUpKeyEvents(KeyEvent.KEYCODE_DPAD_UP)
+            "down" -> ime.sendDownUpKeyEvents(KeyEvent.KEYCODE_DPAD_DOWN)
+            "escape" -> ime.sendDownUpKeyEvents(KeyEvent.KEYCODE_ESCAPE)
+            else -> Log.w(TAG, "unknown key $key")
+        }
+    }
+}
