diff --git a/app/src/main/java/helium314/keyboard/latin/ClipPreview.kt b/app/src/main/java/helium314/keyboard/latin/ClipPreview.kt
new file mode 100644
index 0000000..ea16eaf
--- /dev/null
+++ b/app/src/main/java/helium314/keyboard/latin/ClipPreview.kt
@@ -0,0 +1,67 @@
+// SPDX-License-Identifier: GPL-3.0-only
+// phonectl Keyboard. See phonectl/keyboard/README.md.
+
+package helium314.keyboard.latin
+
+/**
+ * One-line preview of a clip for the clipboard chip in the suggestion strip. Links lose their scheme
+ * and are cut in the middle (domain and end stay visible); commands and code keep their characters and
+ * show line breaks as a return sign; other text has its whitespace collapsed.
+ */
+data class ClipPreview(val text: String, val kind: Kind) {
+    enum class Kind { URL, CODE, TEXT }
+
+    companion object {
+        private const val MAX_CODE_POINTS = 300
+        private val url = Regex("""^(?:(?:https?|ftp)://|www\.)\S+$""", RegexOption.IGNORE_CASE)
+        private val scheme = Regex("""^(?:(?:https?|ftp)://)?(?:www\.)?""", RegexOption.IGNORE_CASE)
+        private val shellStart = Regex(
+            """^(?:[$#>]\s|\./|~/|/[\w.-]+/|(?:sudo|git|cd|ls|npm|npx|pnpm|yarn|pip3?|python3?|cargo|adb|ssh|scp|rsync|curl|wget|docker|kubectl|systemctl|journalctl|rg|chmod|chown|mkdir|pacman|apt|brew|gh)\s)""")
+        private val weakShellStart = Regex("""^(?:make|find|cat|echo|rm|cp|mv|go|node|grep|sed|awk|tar|nix|java|gradle|export)\s""")
+        private val shellArg = Regex("""\s[-./~$]|\S/\S|=""")
+        private val codeMarks = Regex("""\s\|\s|\S\|\S|&&|\|\||;\s*$|`|\$\(|\$\{|\$[A-Z_]{2,}|=>|::|\s--[a-z][\w-]*|\s-[a-zA-Z]{1,3}(?:\s|$)|[{}]\s*$|^\s*(?:def|fun|function|class|import|const|let|var|return)\s""")
+
+        fun of(content: CharSequence): ClipPreview {
+            val clean = sanitize(content)
+            val trimmed = clean.trim()
+            if (url.matches(trimmed)) {
+                return ClipPreview(trimmed.replace(scheme, "").removeSuffix("/"), Kind.URL)
+            }
+            val lines = trimmed.lines().map { it.trimEnd() }.filter { it.isNotBlank() }
+            val isCode = lines.isNotEmpty() && lines.take(5).any { isCodeLine(it) }
+            return if (isCode) {
+                ClipPreview(lines.joinToString("  ⏎  ") { it.trim().replace(Regex("""[ \t]{2,}"""), " ") }, Kind.CODE)
+            } else {
+                ClipPreview(trimmed.replace(Regex("""\s+"""), " "), Kind.TEXT)
+            }
+        }
+
+        private fun isCodeLine(line: String): Boolean {
+            val l = line.trimStart()
+            return shellStart.containsMatchIn(l) || (weakShellStart.containsMatchIn(l) && shellArg.containsMatchIn(l))
+                || codeMarks.containsMatchIn(line)
+        }
+
+        /** Drops control, bidi-override and zero-width characters and cuts on a code point boundary. */
+        private fun sanitize(content: CharSequence): String {
+            val sb = StringBuilder()
+            var i = 0
+            var count = 0
+            val s = content.toString()
+            while (i < s.length && count < MAX_CODE_POINTS) {
+                val cp = s.codePointAt(i)
+                i += Character.charCount(cp)
+                count++
+                when {
+                    cp == '\n'.code || cp == '\t'.code -> sb.appendCodePoint(cp)
+                    cp == '\r'.code -> {}
+                    Character.isISOControl(cp) -> sb.append(' ')
+                    cp in 0x202A..0x202E || cp in 0x2066..0x2069 || cp == 0x200B || cp == 0xFEFF -> {}
+                    else -> sb.appendCodePoint(cp)
+                }
+            }
+            if (i < s.length) sb.append('…')
+            return sb.toString()
+        }
+    }
+}
