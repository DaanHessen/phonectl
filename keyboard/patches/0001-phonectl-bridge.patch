+<resources>
+    <string name="phonectl_keyboard_name" translatable="false">phonectl Keyboard</string>
+    <!-- Gboard on a 458 dp wide phone: 46.9 dp keys, 12 dp row gap, 6 dp key gap, 6 dp corners. -->
