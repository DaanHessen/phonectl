+    /** Top of the bottom row (the row with the space key), including half the row gap above it. */
+    private static int bottomRowTop(@Nullable final Keyboard keyboard) {
+        if (keyboard == null) return 0;
+        int top = -1;
+        for (final Key key : keyboard.getSortedKeys()) {
+            if (key.getCode() == helium314.keyboard.latin.common.Constants.CODE_SPACE) {
+                top = key.getY();
+                break;
+            }
+        }
+        if (top < 0) {
+            for (final Key key : keyboard.getSortedKeys())
+                top = Math.max(top, key.getY());
+        }
+        return Math.max(0, top - keyboard.mVerticalGap / 2);
+    }
