+    private const val PHONECTL_LOOK_PREF = "phonectl_look"
+    private const val PHONECTL_LOOK = 1
+
+    // Once per look version: drop look and size prefs so the phonectl defaults apply.
+    private fun applyPhonectlLook(prefs: android.content.SharedPreferences) {
+        if (prefs.getInt(PHONECTL_LOOK_PREF, 0) >= PHONECTL_LOOK) return
+        val keys = listOf(Settings.PREF_THEME_STYLE, Settings.PREF_THEME_COLORS, Settings.PREF_THEME_COLORS_NIGHT,
+            Settings.PREF_THEME_KEY_BORDERS, Settings.PREF_THEME_DAY_NIGHT, Settings.PREF_SHOW_EMOJI_KEY,
+            Settings.PREF_TOOLBAR_KEYS, Settings.PREF_AUTO_SHOW_TOOLBAR, Settings.PREF_AUTO_HIDE_TOOLBAR,
+            Settings.PREF_FONT_SCALE, Settings.PREF_POPUP_KEYS_HINT_ORDER)
+        val prefixes = listOf(Settings.PREF_KEYBOARD_HEIGHT_SCALE_PREFIX, Settings.PREF_BOTTOM_PADDING_SCALE_PREFIX,
+            Settings.PREF_SIDE_PADDING_SCALE_PREFIX, Settings.PREF_KEY_GAP_SCALE_PREFIX, Settings.PREF_BOTTOM_ROW_SCALE_PREFIX)
+        prefs.edit {
+            keys.forEach { remove(it) }
+            prefs.all.keys.filter { key -> prefixes.any { key.startsWith(it) } }.forEach { remove(it) }
+            putInt(PHONECTL_LOOK_PREF, PHONECTL_LOOK)
+        }
+    }
+
     // old variant for old folder structure
