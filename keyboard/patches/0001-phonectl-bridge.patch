+    /** Deletes once on touch, then repeats like the keyboard's delete key while held. */
+    private final class DeleteRepeater implements Runnable {
+        private View mView;
+        private int mCount;
+
+        void start(final View view) {
+            stop();
+            mView = view;
+            mCount = 0;
+            run();
+        }
+
+        void stop() {
+            if (mView != null) mView.removeCallbacks(this);
+            mView = null;
+        }
+
+        @Override
+        public void run() {
+            if (mView == null) return;
+            mKeyboardActionListener.onCodeInput(KeyCode.DELETE, NOT_A_COORDINATE, NOT_A_COORDINATE, mCount > 0);
+            if (mCount > 0)
+                AudioAndHapticFeedbackManager.getInstance().performHapticAndAudioFeedback(KeyCode.DELETE, mView, HapticEvent.KEY_REPEAT);
+            mCount++;
+            mView.postDelayed(this, mCount == 1 ? Settings.getValues().mKeyLongpressTimeout : 50);
+        }
+    }
