+    private void addDeleteButton(final LinearLayout host) {
+        final Context context = getContext();
+        final ImageView view = new ImageView(context);
+        view.setImageDrawable(KeyboardIconsSet.Companion.getInstance().getNewDrawable(KeyboardIconsSet.NAME_DELETE_KEY, context));
+        mColors.setColor(view, ColorType.EMOJI_CATEGORY_SELECTED);
+        view.setScaleType(ImageView.ScaleType.CENTER_INSIDE);
+        final int pad = (int) (8 * getResources().getDisplayMetrics().density);
+        view.setPadding(pad, pad, pad, pad);
+        view.setContentDescription(context.getString(R.string.spoken_description_delete));
+        view.setOnTouchListener((v, event) -> {
+            switch (event.getActionMasked()) {
+                case android.view.MotionEvent.ACTION_DOWN -> {
+                    v.setPressed(true);
+                    mKeyboardActionListener.onPressKey(KeyCode.DELETE, 0, 1, HapticEvent.KEY_PRESS);
+                    mDeleteRepeater.start(v);
+                }
+                case android.view.MotionEvent.ACTION_UP, android.view.MotionEvent.ACTION_CANCEL -> {
+                    v.setPressed(false);
+                    mDeleteRepeater.stop();
+                    mKeyboardActionListener.onReleaseKey(KeyCode.DELETE, false);
+                }
+            }
+            return true;
+        });
+        host.addView(view, new LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.MATCH_PARENT, 1.4f));
