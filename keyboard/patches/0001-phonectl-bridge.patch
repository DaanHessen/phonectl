diff --git a/app/src/main/java/helium314/keyboard/keyboard/emoji/InlineEmojiSearch.kt b/app/src/main/java/helium314/keyboard/keyboard/emoji/InlineEmojiSearch.kt
new file mode 100644
index 0000000..2df09a0
--- /dev/null
+++ b/app/src/main/java/helium314/keyboard/keyboard/emoji/InlineEmojiSearch.kt
@@ -0,0 +1,353 @@
+// SPDX-License-Identifier: GPL-3.0-only
+package helium314.keyboard.keyboard.emoji
+
+import android.animation.ValueAnimator
+import android.content.Context
+import android.graphics.Typeface
+import android.graphics.drawable.GradientDrawable
+import android.graphics.drawable.StateListDrawable
+import android.os.Handler
+import android.os.Looper
+import android.util.TypedValue
+import android.view.Gravity
+import android.view.View
+import android.view.ViewGroup
+import android.widget.FrameLayout
+import android.widget.HorizontalScrollView
+import android.widget.ImageView
+import android.widget.LinearLayout
+import android.widget.TextView
+import helium314.keyboard.event.Event
+import helium314.keyboard.keyboard.KeyboardSwitcher
+import helium314.keyboard.keyboard.internal.KeyboardIconsSet
+import helium314.keyboard.keyboard.internal.keyboard_parser.floris.KeyCode
+import helium314.keyboard.keyboard.internal.keyboard_parser.getEmojiDefaultVersion
+import helium314.keyboard.latin.R
+import helium314.keyboard.latin.RichInputMethodManager
+import helium314.keyboard.latin.SingleDictionaryFacilitator
+import helium314.keyboard.latin.common.ColorType
+import helium314.keyboard.latin.common.splitOnWhitespace
+import helium314.keyboard.latin.dictionary.DictionaryFactory
+import helium314.keyboard.latin.settings.Settings
+import helium314.keyboard.latin.utils.DictionaryInfoUtils
+import java.util.concurrent.Executors
+
+/**
+ * Gboard-like emoji search inside the keyboard, in the strip row (the keyboard keeps its height): a search field and
+ * the matching emojis next to it. The letter keys type into the field (nothing reaches the app), tapping an emoji
+ * inserts it and the keyboard stays open.
+ * The query is kept in memory only and dropped when the search ends.
+ */
+object InlineEmojiSearch {
+    private const val MAX_RESULTS = 40
+
+    private val main = Handler(Looper.getMainLooper())
+    private val worker = Executors.newSingleThreadExecutor { Thread(it, "emoji-search").apply { isDaemon = true } }
+    private val query = StringBuilder()
+    private var root: LinearLayout? = null
+    private var container: FrameLayout? = null
+    private val hiddenSiblings = mutableListOf<Pair<View, Int>>()
+    private var queryView: TextView? = null
+    private var caret: CaretSpan? = null
+    private var hintText = ""
+    private var hintColorValue = 0
+    private var caretAnimator: ValueAnimator? = null
+    private var results: LinearLayout? = null
+    private var resultsScroll: HorizontalScrollView? = null
+    private var onPick: ((String) -> Unit)? = null
+    private var generation = 0
+
+    @Volatile private var facilitators: List<SingleDictionaryFacilitator> = emptyList()
+    private var facilitatorKey: List<String> = emptyList()
+
+    @JvmStatic
+    val isActive: Boolean get() = root != null
+
+    @JvmStatic
+    fun start(context: Context, strip: FrameLayout, pick: (String) -> Unit, close: () -> Unit) {
+        if (root != null) stop()
+        onPick = pick
+        query.setLength(0)
+        container = strip
+        val density = context.resources.displayMetrics.density
+        val colors = Settings.getValues().mColors
+        val rowHeight = context.resources.getDimensionPixelSize(R.dimen.config_suggestions_strip_height)
+
+        val fieldBackground = GradientDrawable().apply {
+            cornerRadius = 500f * density
+            setColor(colors.get(ColorType.EMOJI_SEARCH_BACKGROUND))
+        }
+        val textColor = colors.get(ColorType.EMOJI_SEARCH_TEXT)
+        val hintColor = (textColor and 0x00ffffff) or (0x80 shl 24)
+
+        val icon = ImageView(context).apply {
+            setImageDrawable(KeyboardIconsSet.instance.getNewDrawable(KeyboardIconsSet.NAME_SEARCH_KEY, context))
+            colorFilter = android.graphics.PorterDuffColorFilter(hintColor, android.graphics.PorterDuff.Mode.SRC_IN)
+        }
+        val text = TextView(context).apply {
+            setTextSize(TypedValue.COMPLEX_UNIT_SP, 15f)
+            setTextColor(textColor)
+            maxLines = 1
+            ellipsize = android.text.TextUtils.TruncateAt.START
+            gravity = Gravity.CENTER_VERTICAL
+            includeFontPadding = false
+        }
+        queryView = text
+        val caretSpan = CaretSpan(textColor, (2 * density).toInt(), (1 * density).toInt())
+        caret = caretSpan
+        hintText = context.getString(R.string.search_field_placeholder)
+        hintColorValue = hintColor
+        val clear = ImageView(context).apply {
+            setImageResource(R.drawable.ic_close)
+            colorFilter = android.graphics.PorterDuffColorFilter(textColor, android.graphics.PorterDuff.Mode.SRC_IN)
+            scaleType = ImageView.ScaleType.CENTER_INSIDE
+            contentDescription = context.getString(android.R.string.cancel)
+            setOnClickListener { close() }
+        }
+
+        val field = LinearLayout(context).apply {
+            orientation = LinearLayout.HORIZONTAL
+            gravity = Gravity.CENTER_VERTICAL
+            background = fieldBackground
+            addView(icon, LinearLayout.LayoutParams((20 * density).toInt(), (20 * density).toInt()).apply {
+                marginStart = (14 * density).toInt()
+                marginEnd = (8 * density).toInt()
+            })
+            addView(text, LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1f))
+            addView(clear, LinearLayout.LayoutParams((36 * density).toInt(), ViewGroup.LayoutParams.MATCH_PARENT))
+        }
+        val fieldRow = FrameLayout(context).apply {
+            addView(field, FrameLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, (rowHeight - 12 * density).toInt(),
+                Gravity.CENTER_VERTICAL).apply {
+                marginStart = (6 * density).toInt()
+                marginEnd = (4 * density).toInt()
+            })
+        }
+
+        val list = LinearLayout(context).apply { orientation = LinearLayout.HORIZONTAL }
+        results = list
+        val scroll = HorizontalScrollView(context).apply {
+            isHorizontalScrollBarEnabled = false
+            overScrollMode = View.OVER_SCROLL_NEVER
+            addView(list, FrameLayout.LayoutParams(ViewGroup.LayoutParams.WRAP_CONTENT, ViewGroup.LayoutParams.MATCH_PARENT))
+        }
+        resultsScroll = scroll
+
+        val rootView = LinearLayout(context).apply {
+            orientation = LinearLayout.HORIZONTAL
+            isClickable = true
+            setBackgroundColor(colors.get(ColorType.MAIN_BACKGROUND))
+            addView(fieldRow, LinearLayout.LayoutParams(0, rowHeight, 0.44f))
+            addView(scroll, LinearLayout.LayoutParams(0, rowHeight, 0.56f))
+        }
+        root = rootView
+
+        hiddenSiblings.clear()
+        for (i in 0 until strip.childCount) {
+            val child = strip.getChildAt(i)
+            hiddenSiblings.add(child to child.visibility)
+            child.visibility = View.INVISIBLE
+        }
+        strip.visibility = View.VISIBLE
+        strip.addView(rootView, FrameLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT))
+
+        caretAnimator = ValueAnimator.ofFloat(1f, 0f).apply {
+            duration = 530
+            repeatMode = ValueAnimator.REVERSE
+            repeatCount = ValueAnimator.INFINITE
+            addUpdateListener {
+                val on = (it.animatedValue as Float) > 0.5f
+                if (caretSpan.visible != on) {
+                    caretSpan.visible = on
+                    text.invalidate()
+                }
+            }
+            start()
+        }
+        refreshQuery()
+        warmUp(context)
+    }
+
+    @JvmStatic
+    fun stop() {
+        generation++
+        caretAnimator?.cancel()
+        caretAnimator = null
+        val rootView = root ?: return
+        (rootView.parent as? ViewGroup)?.removeView(rootView)
+        hiddenSiblings.forEach { (view, visibility) -> view.visibility = visibility }
+        hiddenSiblings.clear()
+        root = null
+        container = null
+        queryView = null
+        caret = null
+        results = null
+        resultsScroll = null
+        onPick = null
+        query.setLength(0)
+    }
+
+    /** Returns true if the keyboard switcher should also see the event (shift, layout switches, and so on). */
+    @JvmStatic
+    fun onEvent(event: Event): Boolean {
+        val code = event.keyCode
+        when {
+            code == KeyCode.DELETE -> {
+                if (query.isNotEmpty()) {
+                    query.setLength(query.offsetByCodePoints(query.length, -1))
+                    queryChanged()
+                }
+                return false
+            }
+            code == KeyCode.EMOJI -> {
+                stop()
+                return false
+            }
+            code == KeyCode.ALPHA || code == KeyCode.SYMBOL || code == KeyCode.SYMBOL_ALPHA -> {
+                stop()
+                return true
+            }
+            code == KeyCode.SHIFT -> return true
+            event.codePoint >= 0 && event.metaState == 0 -> {
+                if (event.codePoint != '\n'.code) appendText(String(Character.toChars(event.codePoint)))
+                return true
+            }
+        }
+        return false
+    }
+
+    @JvmStatic
+    fun onText(text: String) = appendText(text)
+
+    private fun appendText(text: String) {
+        if (query.length >= 40) return
+        query.append(text.lowercase())
+        queryChanged()
+    }
+
+    private fun queryChanged() {
+        refreshQuery()
+    }
+
+    private fun refreshQuery() {
+        renderQuery()
+        if (query.isBlank()) {
+            generation++
+            showResults(RecentEmojis.get())
+        } else search(query.toString())
+    }
+
+    private fun warmUp(context: Context) {
+        worker.execute { runCatching { initFacilitators(context.applicationContext) } }
+    }
+
+    private fun search(text: String) {
+        val gen = ++generation
+        val context = root?.context?.applicationContext ?: return
+        worker.execute {
+            if (gen != generation) return@execute
+            val found = runCatching {
+                initFacilitators(context)
+                if (KeyboardSwitcher.getInstance().keyboard == null) emptyList()
+                else lookup(text)
+            }.getOrDefault(emptyList())
+            main.post { if (gen == generation) showResults(found) }
+        }
+    }
+
+    private fun lookup(text: String): List<String> {
+        val words = text.splitOnWhitespace()
+        if (words.isEmpty()) return emptyList()
+        val found = LinkedHashMap<String, Int>()
+        facilitators.forEach { facilitator ->
+            facilitator.getSuggestions(words).filter { it.isEmoji }.forEach { info ->
+                val emoji = getEmojiDefaultVersion(info.word)
+                if (info.mScore > (found[emoji] ?: Int.MIN_VALUE)) found[emoji] = info.mScore
+            }
+        }
+        return found.entries.sortedByDescending { it.value }.map { it.key }.take(MAX_RESULTS)
+    }
+
+    @Synchronized
+    private fun initFacilitators(context: Context) {
+        val current = RichInputMethodManager.getInstance().currentSubtype.locale
+        val locales = listOf(current, java.util.Locale.ENGLISH, java.util.Locale("nl"))
+        val files = locales.mapNotNull { l -> DictionaryInfoUtils.getOrExtractEmojiDict(l, context)?.let { l to it } }
+            .distinctBy { it.second.path }
+        val key = files.map { it.second.path }
+        if (key == facilitatorKey && facilitators.isNotEmpty()) return
+        closeDictionaries()
+        facilitators = files.mapNotNull { (l, f) -> DictionaryFactory.getDictionary(f, l)?.let { SingleDictionaryFacilitator(it) } }
+        facilitatorKey = key
+    }
+
+    @JvmStatic
+    @Synchronized
+    fun closeDictionaries() {
+        facilitators.forEach { it.closeDictionaries() }
+        facilitators = emptyList()
+        facilitatorKey = emptyList()
+    }
+
+    private fun showResults(emojis: List<String>) {
+        val list = results ?: return
+        val context = list.context
+        val density = context.resources.displayMetrics.density
+        val colors = Settings.getValues().mColors
+        list.removeAllViews()
+        resultsScroll?.scrollTo(0, 0)
+        emojis.forEach { emoji ->
+            val cell = TextView(context).apply {
+                text = emoji
+                setTextSize(TypedValue.COMPLEX_UNIT_SP, 24f)
+                typeface = Typeface.DEFAULT
+                gravity = Gravity.CENTER
+                includeFontPadding = false
+                background = StateListDrawable().apply {
+                    addState(intArrayOf(android.R.attr.state_pressed), GradientDrawable().apply {
+                        cornerRadius = 8 * density
+                        setColor(colors.get(ColorType.EMOJI_SEARCH_BACKGROUND))
+                    })
+                }
+                setOnClickListener {
+                    RecentEmojis.add(emoji)
+                    onPick?.invoke(emoji)
+                }
+                importantForAccessibility = View.IMPORTANT_FOR_ACCESSIBILITY_YES
+            }
+            list.addView(cell, LinearLayout.LayoutParams((44 * density).toInt(), ViewGroup.LayoutParams.MATCH_PARENT))
+        }
+    }
+
+    private fun renderQuery() {
+        val view = queryView ?: return
+        val span = caret ?: return
+        val sb = android.text.SpannableStringBuilder(query)
+        val caretAt = sb.length
+        sb.append('\u200B')
+        sb.setSpan(span, caretAt, caretAt + 1, android.text.Spanned.SPAN_EXCLUSIVE_EXCLUSIVE)
+        if (query.isEmpty()) {
+            val start = sb.length
+            sb.append(hintText)
+            sb.setSpan(android.text.style.ForegroundColorSpan(hintColorValue), start, sb.length, android.text.Spanned.SPAN_EXCLUSIVE_EXCLUSIVE)
+        }
+        view.text = sb
+    }
+
+    /** Blinking text cursor drawn in the text, so it sits right after the query (or before the hint). */
+    private class CaretSpan(color: Int, private val width: Int, private val gap: Int) : android.text.style.ReplacementSpan() {
+        private val paint = android.graphics.Paint().apply { this.color = color }
+        var visible = true
+
+        override fun getSize(p: android.graphics.Paint, text: CharSequence?, start: Int, end: Int, fm: android.graphics.Paint.FontMetricsInt?): Int {
+            if (fm != null) p.getFontMetricsInt(fm)
+            return width + 2 * gap
+        }
+
+        override fun draw(canvas: android.graphics.Canvas, text: CharSequence?, start: Int, end: Int, x: Float, top: Int, y: Int, bottom: Int, p: android.graphics.Paint) {
+            if (!visible) return
+            val fm = p.fontMetrics
+            canvas.drawRect(x + gap, y + fm.ascent * 0.95f, x + gap + width, y + fm.descent * 0.9f, paint)
+        }
+    }
+}
