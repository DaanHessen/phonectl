diff --git a/app/src/main/java/helium314/keyboard/latin/ImeNavBarFill.kt b/app/src/main/java/helium314/keyboard/latin/ImeNavBarFill.kt
new file mode 100644
index 0000000..781e98d
--- /dev/null
+++ b/app/src/main/java/helium314/keyboard/latin/ImeNavBarFill.kt
@@ -0,0 +1,92 @@
+// SPDX-License-Identifier: GPL-3.0-only
+// phonectl Keyboard. See phonectl/keyboard/README.md.
+
+package helium314.keyboard.latin
+
+import android.graphics.Canvas
+import android.graphics.ColorFilter
+import android.graphics.Paint
+import android.graphics.PixelFormat
+import android.graphics.drawable.Drawable
+import android.os.Build
+import android.view.View
+import android.view.ViewTreeObserver
+import android.view.Window
+
+/**
+ * Paints the navigation bar area below the keyboard in the keyboard's own background colour.
+ *
+ * Apps targeting Android 15+ are edge-to-edge: Window.setNavigationBarColor is ignored, and the
+ * gesture handle / IME back and switcher buttons sit in a frame with no background. Without this
+ * the app behind the keyboard shows through that 48 dp band (blended with a translucent scrim).
+ * The window background only draws from the bottom of the input view down, so nothing is
+ * painted over the app above the keyboard.
+ */
+object ImeNavBarFill {
+    private var fill: BottomFill? = null
+    private var observed: View? = null
+    private val listener = ViewTreeObserver.OnGlobalLayoutListener { update() }
+
+    @JvmStatic
+    fun apply(window: Window?, inputView: View?, color: Int, enabled: Boolean) {
+        if (window == null || inputView == null) return
+        if (!enabled) {
+            if (fill != null) window.setBackgroundDrawable(null)
+            detach()
+            fill = null
+            return
+        }
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.Q) window.isNavigationBarContrastEnforced = false
+        val f = fill ?: BottomFill().also { fill = it }
+        f.color = color
+        if (window.decorView.background !== f) window.setBackgroundDrawable(f)
+        if (observed !== inputView) {
+            detach()
+            observed = inputView
+            inputView.viewTreeObserver.addOnGlobalLayoutListener(listener)
+        }
+        update()
+    }
+
+    private fun detach() {
+        observed?.viewTreeObserver?.let { if (it.isAlive) it.removeOnGlobalLayoutListener(listener) }
+        observed = null
+    }
+
+    private fun update() {
+        val view = observed ?: return
+        val f = fill ?: return
+        if (!view.isAttachedToWindow) return
+        val loc = IntArray(2)
+        view.getLocationInWindow(loc)
+        val top = loc[1] + view.height
+        if (top != f.top) {
+            f.top = top
+            f.invalidateSelf()
+        }
+    }
+
+    private class BottomFill : Drawable() {
+        private val paint = Paint()
+        var top = Int.MAX_VALUE
+        var color: Int
+            get() = paint.color
+            set(value) {
+                if (paint.color != value) {
+                    paint.color = value
+                    invalidateSelf()
+                }
+            }
+
+        override fun draw(canvas: Canvas) {
+            val b = bounds
+            if (top >= b.bottom) return
+            canvas.drawRect(b.left.toFloat(), top.coerceAtLeast(b.top).toFloat(), b.right.toFloat(), b.bottom.toFloat(), paint)
+        }
+
+        override fun setAlpha(alpha: Int) {}
+        override fun setColorFilter(colorFilter: ColorFilter?) {}
+        @Deprecated("Deprecated in Java")
+        override fun getOpacity() = PixelFormat.TRANSLUCENT
+    }
+}
